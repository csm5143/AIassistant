# Public repository allowlist. New files require an explicit publication decision.
/*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/README.md
!/LICENSE
!/SECURITY.md
!/CONTRIBUTING.md
!/compose.yaml
!/.env.docker.example
!/backend/
/backend/*
!/backend/pom.xml
!/backend/Dockerfile
!/backend/src/
!/user-frontend/
/user-frontend/*
!/user-frontend/src/
!/user-frontend/public/
!/user-frontend/tests/
!/user-frontend/package.json
!/user-frontend/package-lock.json
!/user-frontend/tsconfig*.json
!/user-frontend/vite.config.ts
!/user-frontend/env.d.ts
!/user-frontend/index.html
!/user-frontend/Dockerfile
!/deployment/
/deployment/*
!/deployment/init-env.py
!/deployment/nginx.conf
!/deployment/compose.local-folders.yaml
!/deployment/pdf-parser/
/deployment/pdf-parser/*
!/deployment/pdf-parser/*.py
!/deployment/pdf-parser/requirements*.txt
!/deployment/pdf-parser/Dockerfile
!/deployment/pdf-parser/entrypoint.sh
!/docs/
/docs/*
!/docs/public/
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.mjs
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
**/.env
**/.env.*
!/.env.docker.example
**/application-dev.yml
**/application-local*.yml
**/*.key
**/*.pem
**/*.p12
**/*.jks
**/node_modules/
**/target/
**/dist/
**/__pycache__/
**/*.pyc
**/*.log
**/*.dump
**/uploads/
**/runtime/
user-frontend/public/evaluations/
**/.DS_Store
